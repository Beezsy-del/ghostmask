{
  "name": "ghostmask",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "demo": "node scripts/demo.mjs",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/build-test.mjs && npm run test:browser",
    "package": "npm run build && python3 scripts/package.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/chrome": "^0.1.31",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.25.12",
    "pngjs": "^7.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "compromise": "14.20.0",
    "tesseract.js": "7.0.0"
  }
}
